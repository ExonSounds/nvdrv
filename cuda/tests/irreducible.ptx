//
// SPDX-License-Identifier: MIT
// A loop with two entries (irreducible control flow). i = tid; odd tids start at B, even at A;
// A: acc += 3, i += 1; B: acc ^= i, i += 2; each exits when i >= limit. ptxtest accepts a clean
// refusal (Mesa's structurizer cannot do this shape) but never a wrong result.
//
.version 7.5
.target sm_86
.address_size 64

.visible .entry irr(
	.param .u64 irr_param_0,
	.param .u32 irr_param_1
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd0, [irr_param_0];
	ld.param.u32 	%r7, [irr_param_1];
	mov.u32 	%r0, %tid.x;
	mov.u32 	%r1, %ctaid.x;
	mov.u32 	%r2, %ntid.x;
	mad.lo.s32 	%r0, %r1, %r2, %r0;
	mov.u32 	%r3, %r0;
	mov.u32 	%r4, 0;
	and.b32  	%r5, %r0, 1;
	setp.ne.s32	%p0, %r5, 0;
	@%p0 bra 	$L_B;
$L_A:
	add.s32 	%r4, %r4, 3;
	add.s32 	%r3, %r3, 1;
	setp.ge.u32	%p1, %r3, %r7;
	@%p1 bra 	$L_E;
	bra.uni 	$L_B;
$L_B:
	xor.b32  	%r4, %r4, %r3;
	add.s32 	%r3, %r3, 2;
	setp.ge.u32	%p2, %r3, %r7;
	@%p2 bra 	$L_E;
	bra.uni 	$L_A;
$L_E:
	cvta.to.global.u64 	%rd1, %rd0;
	mul.wide.u32 	%rd2, %r0, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r4;
	ret;
}
