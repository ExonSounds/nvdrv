+/// A set of SSA values stored as a map of 64-bit words (nvdrv/nvcuda): a dense BitSet per
+/// block is sized to the whole function's value count, and large compute kernels (a path
+/// tracer's shading kernels: ~16K blocks, ~1M values) ran out of memory in the liveness
+/// dataflow.
+#[derive(Clone, Default)]
+pub struct SparseSSASet {
+    words: FxHashMap<u32, u64>,
+}
+
+impl SparseSSASet {
+    #[inline]
+    fn split(ssa: &SSAValue) -> (u32, u64) {
+        let i = ssa.idx();
+        (i >> 6, 1_u64 << (i & 63))
+    }
+
+    pub fn contains(&self, ssa: &SSAValue) -> bool {
+        let (w, m) = Self::split(ssa);
+        self.words.get(&w).map_or(false, |b| b & m != 0)
+    }
+
+    pub fn insert(&mut self, ssa: &SSAValue) -> bool {
+        let (w, m) = Self::split(ssa);
+        let b = self.words.entry(w).or_insert(0);
+        let new = *b & m == 0;
+        *b |= m;
+        new
+    }
+
+    /// self |= other; true if self grew
+    pub fn union_with(&mut self, other: &SparseSSASet) -> bool {
+        let mut changed = false;
+        for (w, ob) in other.words.iter() {
+            let b = self.words.entry(*w).or_insert(0);
+            if *b | ob != *b {
+                *b |= ob;
+                changed = true;
+            }
+        }
+        changed
+    }
+
+    /// self |= (a | b) - c; true if self grew
+    pub fn union_with_diff(
+        &mut self,
+        a: &SparseSSASet,
+        b: &SparseSSASet,
+        c: &SparseSSASet,
+    ) -> bool {
+        let mut changed = false;
+        for src in [a, b] {
+            for (w, bits) in src.words.iter() {
+                let bits = bits & !c.words.get(w).copied().unwrap_or(0);
+                if bits != 0 {
+                    let e = self.words.entry(*w).or_insert(0);
+                    if *e | bits != *e {
+                        *e |= bits;
+                        changed = true;
+                    }
+                }
+            }
+        }
+        changed
+    }
+}
